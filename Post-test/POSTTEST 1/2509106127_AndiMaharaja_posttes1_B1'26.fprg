<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2509106127_AndiMaharaja_posttes1_B1'26"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-13 07:00:59 PM"/>
        <attribute name="created" value="VXNlcjtMQVBUT1AtVFY1UjhCUUI7MjAyNi0wOS0xMzswNTo1NTo0OSBQTTsyNzkz"/>
        <attribute name="edited" value="VXNlcjtMQVBUT1AtVFY1UjhCUUI7MjAyNi0wOS0xMzswNzowMDo1OSBQTTsxOzI4OTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="saldo, tarif, kekurangan" type="Real" array="False" size=""/>
            <declare name="golongan" type="Integer" array="False" size=""/>
            <output expression="&quot;==System cek Saldo E-tol==&quot;" newline="True"/>
            <output expression="&quot;==masukkan saldo awal==&quot;" newline="True"/>
            <input variable="saldo"/>
            <output expression="&quot;Masukkan Golongan Kendaraan 1= Mobil 2= Truck&quot;" newline="True"/>
            <input variable="golongan"/>
            <if expression="golongan=1">
                <then>
                    <assign variable="tarif" expression="75000"/>
                </then>
                <else>
                    <if expression="golongan=2">
                        <then>
                            <assign variable="tarif" expression="125000"/>
                        </then>
                        <else>
                            <output expression="&quot;Golongan Tidak Valid&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="saldo&gt;=tarif">
                <then>
                    <output expression="&quot;Saldo cukup!&quot;" newline="True"/>
                    <output expression="&quot;silahkan melintas&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Saldo tidak mencukupi!&quot;" newline="True"/>
                    <output expression="&quot;Segera lakukan top up sebesar Rp  &amp; kekurangan&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
